# Base URL of the FastAPI service (backend/app/api/main.py), no trailing slash.
# Leave unset to run the dashboard against the built-in demo fixtures.
NEXT_PUBLIC_FASTAPI_BASE=http://localhost:8000

# Base URL of the Django back-office (backend/django_admin), no trailing slash.
# Leave unset to run the dashboard against the built-in demo fixtures.
NEXT_PUBLIC_DJANGO_BASE=http://localhost:8001
